          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      <Footer />"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  );"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
      }
    }
    instruction: "Refine the styling of all sections in App.tsx to match the \"Professional Polish\" design theme, including specific card borders, shadows, and spacing patterns."
    replacement_infos {
      original_chunk {
        target_content: "const Navbar = () => {\n  const [isOpen, setIsOpen] = useState(false);\n  const [scrolled, setScrolled] = useState(false);\n\n  useEffect(() => {\n    const handleScroll = () => setScrolled(window.scrollY > 20);\n    window.addEventListener(\'scroll\', handleScroll);\n    return () => window.removeEventListener(\'scroll\', handleScroll);\n  }, []);\n\n  const navLinks = [\n    { name: \'Home\', href: \'#home\' },\n    { name: \'About\', href: \'#about\' },\n    { name: \'Board\', href: \'#board\' },\n    { name: \'Projects\', href: \'#projects\' },\n    { name: \'Events\', href: \'#events\' },\n    { name: \'Partner\', href: \'#partner\' },\n  ];\n\n  return (\n    <nav className={`fixed w-full z-50 transition-all duration-300 ${scrolled ? \'bg-white shadow-md py-4\' : \'bg-transparent py-6\'}`}>\n      <div className=\"max-w-7xl mx-auto px-6 flex justify-between items-center\">\n        <a href=\"#home\" className={`text-2xl font-extrabold tracking-tight ${scrolled ? \'text-rotary-blue\' : \'text-white\'}`}>\n          Rotaract <span className=\"text-rotaract-gold\">Ring Road</span>\n        </a>\n\n        {/* Desktop Links */}\n        <div className=\"hidden md:flex items-center space-x-8\">\n          {navLinks.map((link) => (\n            <a \n              key={link.name} \n              href={link.href} \n              className={`font-semibold hover:text-rotaract-gold transition-colors ${scrolled ? \'text-brand-dark\' : \'text-white\'}`}\n            >\n              {link.name}\n            </a>\n          ))}\n          <a href=\"#donate\" className=\"bg-rotaract-gold text-white px-6 py-2.5 rounded-full font-bold hover:bg-opacity-90 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5\">\n            Donate\n          </a>\n        </div>\n\n        {/* Mobile Toggle */}\n        <button className=\"md:hidden text-rotary-blue\" onClick={() => setIsOpen(!isOpen)}>\n          {isOpen ? <X size={28} className={scrolled ? \'text-brand-dark\' : \'text-white\'} /> : <Menu size={28} className={scrolled ? \'text-brand-dark\' : \'text-white\'} />}\n        </button>\n      </div>\n\n      {/* Mobile Drawer */}\n      <AnimatePresence>\n        {isOpen && (\n          <motion.div \n            initial={{ opacity: 0, y: -20 }}\n            animate={{ opacity: 1, y: 0 }}\n            exit={{ opacity: 0, y: -20 }}\n            className=\"absolute top-full left-0 w-full bg-white shadow-xl py-8 flex flex-col items-center space-y-6 md:hidden\"\n          >\n            {navLinks.map((link) => (\n              <a \n                key={link.name} \n                href={link.href} \n                onClick={() => setIsOpen(false)}\n                className=\"text-brand-dark font-bold text-xl hover:text-rotary-blue\"\n              >\n                {link.name}\n              </a>\n            ))}\n            <a h=\"red\" href=\"#donate\" onClick={() => setIsOpen(false)} className=\"bg-rotaract-gold text-white px-8 py-3 rounded-full font-bold text-xl\">\n              Donate\n            </a>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </nav>\n  );\n};\n\nconst Hero = () => {\n  return (\n    <section id=\"home\" className=\"relative min-h-screen bg-rotary-blue flex items-center overflow-hidden\">\n      <div className=\"absolute inset-0 hero-pattern opacity-20\"></div>\n      \n      <div className=\"max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-center z-10 pt-20\">\n        <motion.div \n          initial={{ opacity: 0, x: -50 }}\n          whileInView={{ opacity: 1, x: 0 }}\n          transition={{ duration: 0.8 }}\n          viewport={{ once: true }}\n        >\n          <span className=\"inline-block px-4 py-1.5 bg-white/10 text-rotaract-gold rounded-full text-sm font-bold tracking-widest uppercase mb-6 backdrop-blur-sm border border-white/20\">\n            Service Above Self \302\267 Ibadan, Nigeria\n          </span>\n          <h1 className=\"text-5xl md:text-7xl font-extrabold text-white leading-tight mb-6\">\n            Young Leaders. <br />\n            <span className=\"text-rotaract-gold\">Real Service.</span> <br />\n            Lasting Impact.\n          </h1>\n          <p className=\"text-lg md:text-xl text-white/80 mb-10 max-w-lg leading-relaxed\">\n            Rotaract Club of Ring Road Ibadan empowers young professionals to take action in their communities and lead meaningful change.\n          </p>\n          <div className=\"flex flex-col sm:flex-row gap-4\">\n            <a href=\"#partner\" className=\"bg-white text-rotary-blue px-8 py-4 rounded-full font-bold flex items-center justify-center gap-2 hover:bg-gray-100 transition-all shadow-xl group\">\n              Get Involved <ChevronRight size={20} className=\"group-hover:translate-x-1 transition-transform\" />\n            </a>\n            <a href=\"#projects\" className=\"border-2 border-white text-white px-8 py-4 rounded-full font-bold flex items-center justify-center hover:bg-white/10 transition-all\">\n              Our Projects\n            </a>\n          </div>\n        </motion.div>\n\n        <motion.div \n          initial={{ opacity: 0, scale: 0.8 }}\n          whileInView={{ opacity: 1, scale: 1 }}\n          transition={{ duration: 1 }}\n          viewport={{ once: true }}\n          className=\"relative hidden md:block\"\n        >\n          {/* Abstract SVG/CSS Composition */}\n          <div className=\"relative w-full aspect-square\">\n            <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-4/5 h-4/5 bg-rotaract-gold/20 rounded-full blur-3xl animate-pulse\"></div>\n            <motion.div \n              animate={{ rotate: 360 }}\n              transition={{ duration: 40, repeat: Infinity, ease: \"linear\" }}\n              className=\"absolute inset-0 border-[20px] border-dashed border-rotaract-gold opacity-10 rounded-full\"\n            ></motion.div>\n            \n            <div className=\"absolute top-0 right-0 w-64 h-64 bg-rotaract-gold/30 rounded-2xl rotate-12 backdrop-blur-md border border-white/20 flex items-center justify-center\">\n              <Users size={80} className=\"text-white opacity-80\" />\n            </div>\n            \n            <div className=\"absolute bottom-10 left-0 w-72 h-48 bg-white/10 rounded-2xl -rotate-6 backdrop-blur-lg border border-white/10 flex flex-col p-6 justify-end\">\n              <div className=\"w-12 h-2 bg-rotaract-gold rounded mb-2\"></div>\n              <div className=\"w-40 h-2 bg-white/30 rounded\"></div>\n            </div>\n\n            <div className=\"absolute top-1/3 left-1/4 w-32 h-32 bg-rotary-blue rounded-full border-4 border-rotaract-gold flex items-center justify-center z-10 shadow-2xl\">\n              <Heart size={40} className=\"text-rotaract-gold\" />\n            </div>\n          </div>\n        </motion.div>\n      </div>\n\n      <div className=\"absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce\">\n        <a href=\"#impact\" className=\"text-white/50 hover:text-white transition-colors\">\n          <ChevronRight size={32} className=\"rotate-90\" />\n        </a>\n      </div>\n    </section>\n  );\n};\n\nconst Impact = () => {\n  const stats = [\n    { value: 50, label: \'Members\', icon: Users, suffix: \'+\' },\n    { value: 12, label: \'Projects Completed\', icon: CheckCircle2, suffix: \'+\' },\n    { value: 1000, label: \'Lives Impacted\', icon: Heart, suffix: \'+\' },\n    { value: 5, label: \'Years of Service\', icon: Award, suffix: \'+\' },\n  ];\n\n  const Counter = ({ value, suffix }: { value: number, suffix: string }) => {\n    const [count, setCount] = useState(0);\n    const nodeRef = useRef(null);\n\n    useEffect(() => {\n      const observer = new IntersectionObserver((entries) => {\n        if (entries[0].isIntersecting) {\n          let start = 0;\n          const end = value;\n          const duration = 2000;\n          const increment = end / (duration / 16);\n          \n          const timer = setInterval(() => {\n            start += increment;\n            if (start >= end) {\n              setCount(end);\n              clearInterval(timer);\n            } else {\n              setCount(Math.floor(start));\n            }\n          }, 16);\n        }\n      }, { threshold: 0.5 });\n\n      if (nodeRef.current) observer.observe(nodeRef.current);\n      return () => observer.disconnect();\n    }, [value]);\n\n    return <span ref={nodeRef}>{count}{suffix}</span>;\n  };\n\n  return (\n    <section id=\"impact\" className=\"bg-rotary-blue py-16\">\n      <div className=\"max-w-7xl mx-auto px-6\">\n        <div className=\"grid grid-cols-2 lg:grid-cols-4 gap-8\">\n          {stats.map((stat, i) => (\n            <motion.div \n              key={i}\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              transition={{ delay: i * 0.1 }}\n              viewport={{ once: true }}\n              className=\"text-center\"\n            >\n              <stat.icon className=\"mx-auto text-rotaract-gold mb-4\" size={32} />\n              <div className=\"text-4xl md:text-5xl font-black text-white mb-2\">\n                <Counter value={stat.value} suffix={stat.suffix} />\n              </div>\n              <p className=\"text-white/60 font-medium uppercase tracking-widest text-xs\">\n                {stat.label}\n              </p>\n            </motion.div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n};\n\nconst About = () => {\n  const values = [\n    { title: \'Community\', text: \'Rooted in Ibadan, building bridges across our local neighborhoods.\', icon: Globe },\n    { title: \'Leadership\', text: \'Cultivating the next generation of ethical and effective leaders.\', icon: Zap },\n    { title: \'Service\', text: \'Committing our time and talents to projects with tangible impact.\', icon: Heart },\n  ];\n\n  return (\n    <section id=\"about\" className=\"py-24 bg-white overflow-hidden\">\n      <div className=\"max-w-7xl mx-auto px-6\">\n        <div className=\"grid md:grid-cols-2 gap-20 items-center\">\n          <motion.div \n            initial={{ opacity: 0, x: -50 }}\n            whileInView={{ opacity: 1, x: 0 }}\n            transition={{ duration: 0.8 }}\n            viewport={{ once: true }}\n          >\n            <span className=\"text-rotary-blue font-bold uppercase tracking-widest text-sm mb-4 block\">Our Origin & Mission</span>\n            <h2 className=\"text-4xl md:text-5xl font-black text-brand-dark mb-8 leading-tight\">\n              Action Driven by <br />\n              <span className=\"text-rotary-blue underline decoration-rotaract-gold decoration-4 underline-offset-8\">Youth Empowerment.</span>\n            </h2>\n            <div className=\"space-y-6 text-brand-muted leading-relaxed\">\n              <p>\n                The Rotaract Club of Ring Road Ibadan is a vibrant group of young professionals and community leaders dedicated to making a difference. As part of the global Rotary International family, we focus on tackling the challenges facing Ibadan today.\n              </p>\n              <p>\n                Since our charter, we have served as a launchpad for meaningful community development, youth mentorship, and vocational excellence. We believe that when young people unite with a common purpose, no challenge is too great for our city.\n              </p>\n              <p>\n                Whether it is improving local healthcare, supporting education, or protecting our environment, everything we do is guided by the fundamental Rotary vision of a world where people unite and take action.\n              </p>\n            </div>\n          </motion.div>\n\n          <div className=\"space-y-6\">\n            {values.map((v, i) => (\n              <motion.div \n                key={i}\n                initial={{ opacity: 0, x: 50 }}\n                whileInView={{ opacity: 1, x: 0 }}\n                transition={{ delay: i * 0.2 }}\n                viewport={{ once: true }}\n                className=\"bg-brand-bg p-8 rounded-2xl border-l-4 border-rotaract-gold flex gap-6 group hover:shadow-lg transition-all\"\n              >\n                <div className=\"w-14 h-14 bg-rotary-blue rounded-xl flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform\">\n                  <v.icon className=\"text-rotaract-gold\" size={28} />\n                </div>\n                <div>\n                  <h3 className=\"text-xl font-bold text-brand-dark mb-2\">{v.title}</h3>\n                  <p className=\"text-brand-muted leading-relaxed\">{v.text}</p>\n                </div>\n              </motion.div>\n            ))}\n          </div>\n        </div>\n      </div>\n\n      <div className=\"mt-20 bg-rotary-blue py-10\">\n        <div className=\"max-w-7xl mx-auto px-6 flex justify-center\">\n          <p className=\"text-3xl md:text-5xl font-extrabold italic text-rotaract-gold opacity-80 text-center uppercase tracking-tighter\">\n            \"Service Above Self\"\n          </p>\n        </div>\n      </div>\n    </section>\n  );\n};\n\nconst Board = () => {\n  const members = [\n    { name: \'Rtr. Olabisi Adeniyi\', role: \'President\', bio: \'Championing regional growth and youth excellence across Ibadan.\' },\n    { name: \'Rtr. King Praise\', role: \'Vice President & Secretary\', bio: \'Driving administrative efficiency and strategic club coordination.\' },\n    { name: \'Rtr. Abiola Hassan\', role: \'Welfare Director\', bio: \'Ensuring member well-being and fostering a supportive club environment.\' },\n    { name: \'Rtr. Sarah Johnson\', role: \'Public Relations\', bio: \'Managing our voice and amplifying our impact across digital platforms.\' },\n    { name: \'Rtr. Emmanuel Ade\', role: \'Treasurer\', bio: \'Overseeing financial health to maximize resources for community service.\' },\n    { name: \'Rtr. Aisha Bello\', role: \'Service Projects\', bio: \'Leading the charge on the ground for all community development initiatives.\' },\n  ];\n\n  return (\n    <section id=\"board\" className=\"py-24 bg-brand-bg\">\n      <div className=\"max-w-7xl mx-auto px-6\">\n        <div className=\"text-center mb-16\">\n          <h2 className=\"text-4xl md:text-5xl font-black text-brand-dark mb-4\">Meet the Board</h2>\n          <p className=\"text-xl text-brand-muted\">The 2025\342\200\2232026 leadership team driving our mission forward.</p>\n        </div>\n\n        <div className=\"grid md:grid-cols-2 lg:grid-cols-3 gap-8\">\n          {members.map((member, i) => (\n            <motion.div \n              key={i}\n              initial={{ opacity: 0, y: 30 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              transition={{ delay: i * 0.1 }}\n              viewport={{ once: true }}\n              className={`bg-white p-8 rounded-3xl border-2 transition-all ${member.role === \'President\' ? \'border-rotaract-gold shadow-xl scale-105\' : \'border-transparent shadow-sm\'}`}\n            >\n              <div className=\"w-24 h-24 rounded-full bg-rotary-blue flex items-center justify-center text-3xl font-black text-rotaract-gold mb-6 mx-auto\">\n                {member.name.split(\' \').map(n => n[0]).join(\'\').replace(\'Rtr.\', \'\')}\n              </div>\n              <div className=\"text-center\">\n                <h3 className=\"text-2xl font-bold text-brand-dark mb-1\">{member.name}</h3>\n                <p className=\"text-rotary-blue font-bold tracking-wide uppercase text-sm mb-4\">{member.role}</p>\n                <p className=\"text-brand-muted leading-relaxed italic\">\"{member.bio}\"</p>\n              </div>\n            </motion.div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n};\n\nconst Projects = () => {\n  const projects = [\n    { title: \'Health & Wellness\', icon: Stethoscope, desc: \'Mobile clinics and primary health education for local rural settlements.\' },\n    { title: \'Education Outreach\', icon: BookOpen, desc: \'School supply drives and mentorship programs for public students in Ibadan.\' },\n    { title: \'Environmental Action\', icon: Leaf, desc: \'Waste management campaigns and tree-planting drives to green our city.\' },\n    { title: \'Youth Empowerment\', icon: Zap, desc: \'Leadership workshops and networking hubs for young Nigerian professionals.\' },\n    { title: \'Community Development\', icon: Heart, desc: \'Infrastructure repair and clean water projects in underserved areas.\' },\n    { title: \'Vocational Support\', icon: Briefcase, desc: \'Skill-acquisition training and financial literacy seminars for artisans.\' },\n  ];\n\n  return (\n    <section id=\"projects\" className=\"py-24 bg-white\">\n      <div className=\"max-w-7xl mx-auto px-6\">\n        <div className=\"text-center mb-16\">\n          <h2 className=\"text-4xl md:text-5xl font-black text-brand-dark mb-4\">Our Impact in Action</h2>\n          <p className=\"text-xl text-brand-muted\">A snapshot of the work we\'ve done in Ibadan and beyond.</p>\n        </div>\n\n        <div className=\"grid md:grid-cols-2 lg:grid-cols-3 gap-8\">\n          {projects.map((p, i) => (\n            <motion.div \n              key={i}\n              initial={{ opacity: 0, scale: 0.9 }}\n              whileInView={{ opacity: 1, scale: 1 }}\n              transition={{ delay: i * 0.1 }}\n              viewport={{ once: true }}\n              className=\"group p-10 rounded-3xl bg-brand-bg border-t-8 border-transparent hover:border-rotaract-gold hover:shadow-2xl transition-all relative overflow-hidden\"\n            >\n              <div className=\"absolute top-0 right-0 p-8 opacity-5 group-hover:scale-150 transition-transform\">\n                <p.icon size={120} />\n              </div>\n              <p.icon className=\"text-rotaract-gold mb-6\" size={48} />\n              <h3 className=\"text-2xl font-bold text-brand-dark mb-3\">{p.title}</h3>\n              <p className=\"text-brand-muted mb-6 leading-relaxed\">{p.desc}</p>\n              <a href=\"#\" className=\"inline-flex items-center gap-2 text-rotary-blue font-bold group-hover:gap-4 transition-all\">\n                View More <ChevronRight size={18} />\n              </a>\n            </motion.div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n};\n\nconst Events = () => {\n  const events = [\n    { date: \'MAY 10, 2026\', title: \'Club Monthly Meeting\', desc: \'Planning session for our upcoming quarter projects and collaborations.\', lead: \'Rtr. King Praise\' },\n    { date: \'MAY 24, 2026\', title: \'Joint Fellowship Night\', desc: \'A collaborative evening with neighboring clubs for networking and fun.\', lead: \'Rtr. Risqat\' },\n    { date: \'JUN 13, 2026\', title: \'Rotary Fellowship Meeting\', desc: \'Connecting with our sponsoring Rotary Club to align on community goals.\', lead: \'Rtr. Toffy\' },\n  ];\n\n  return (\n    <section id=\"events\" className=\"py-24 bg-brand-bg\">\n      <div className=\"max-w-7xl mx-auto px-6\">\n        <div className=\"flex justify-between items-end mb-16\">\n          <div>\n            <h2 className=\"text-4xl md:text-5xl font-black text-brand-dark mb-4\">What\'s Coming</h2>\n            <p className=\"text-xl text-brand-muted\">Join us at our next outing or meeting.</p>\n          </div>\n          <a href=\"#\" className=\"hidden md:flex text-rotary-blue font-bold items-center gap-2 border-b-2 border-rotary-blue py-1\">\n            View All Events <ExternalLink size={18} />\n          </a>\n        </div>\n\n        <div className=\"space-y-6\">\n          {events.map((e, i) => (\n            <motion.div \n              key={i}\n              initial={{ opacity: 0, x: -30 }}\n              whileInView={{ opacity: 1, x: 0 }}\n              transition={{ delay: i * 0.1 }}\n              viewport={{ once: true }}\n              className=\"bg-white p-8 rounded-3xl flex flex-col md:row items-center md:items-stretch gap-8 shadow-sm hover:shadow-md transition-shadow group\"\n            >\n              <div className=\"bg-rotary-blue text-white p-6 rounded-2xl flex flex-col items-center justify-center min-w-[140px] shadow-lg group-hover:bg-rotaract-gold transition-colors\">\n                <span className=\"text-xs font-bold uppercase tracking-widest opacity-80 mb-1\">{e.date.split(\' \')[0]}</span>\n                <span className=\"text-3xl font-black\">{e.date.split(\' \')[1].replace(\',\', \'\')}</span>\n                <span className=\"text-xs font-bold uppercase tracking-widest opacity-80 mt-1\">{e.date.split(\' \')[2]}</span>\n              </div>\n              <div className=\"flex-1 flex flex-col justify-center\">\n                <h3 className=\"text-2xl font-bold text-brand-dark mb-2\">{e.title}</h3>\n                <p className=\"text-brand-muted mb-4\">{e.desc}</p>\n                <div className=\"flex items-center gap-2 text-rotary-blue font-semibold text-sm\">\n                  <Users size={16} /> <span>Lead: {e.lead}</span>\n                </div>\n              </div>\n              <div className=\"flex items-center\">\n                <button className=\"bg-brand-bg text-brand-dark px-6 py-3 rounded-xl font-bold hover:bg-rotary-blue hover:text-white transition-all flex items-center gap-2\">\n                  <Calendar size={18} /> Add to Calendar\n                </button>\n              </div>\n            </motion.div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n};\n\nconst Partner = () => {\n  return (\n    <section id=\"partner\" className=\"py-24 bg-white\">\n      <div className=\"max-w-7xl mx-auto px-6\">\n        <div className=\"grid md:grid-cols-2 gap-10\">\n          <motion.div \n            initial={{ opacity: 0, x: -30 }}\n            whileInView={{ opacity: 1, x: 0 }}\n            viewport={{ once: true }}\n            className=\"bg-rotary-blue p-12 rounded-[40px] text-white relative overflow-hidden group\"\n          >\n            <div className=\"absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -mr-20 -mt-20 group-hover:scale-150 transition-transform duration-700\"></div>\n            <h3 className=\"text-4xl font-extrabold mb-6\">Become a Partner</h3>\n            <p className=\"text-lg text-white/70 mb-10 leading-relaxed\">\n              For organizations looking to collaborate on community impact projects, sponsor events, or align their brand with youth leadership in Ibadan.\n            </p>\n            <button className=\"bg-rotaract-gold text-white px-10 py-4 rounded-full font-bold text-lg shadow-xl hover:scale-105 transition-transform flex items-center gap-3\">\n              Partner With Us <Briefcase size={20} />\n            </button>\n          </motion.div>\n\n          <motion.div \n            initial={{ opacity: 0, x: 30 }}\n            whileInView={{ opacity: 1, x: 0 }}\n            viewport={{ once: true }}\n            className=\"bg-rotaract-gold/10 p-12 rounded-[40px] border-2 border-dashed border-rotaract-gold relative overflow-hidden group\"\n          >\n            <div className=\"absolute bottom-0 left-0 w-48 h-48 bg-rotaract-gold/10 rounded-full -ml-10 -mb-10 group-hover:scale-125 transition-transform duration-700\"></div>\n            <h3 className=\"text-4xl font-extrabold text-brand-dark mb-6\">Volunteer With Us</h3>\n            <p className=\"text-lg text-brand-muted mb-10 leading-relaxed\">\n              Join our community of action. Whether you\'re a Rotaractor or not, there\'s a place for you in our work. Let\'s impact Ibadan together.\n            </p>\n            <button className=\"bg-rotary-blue text-white px-10 py-4 rounded-full font-bold text-lg shadow-xl hover:scale-105 transition-transform flex items-center gap-3\">\n              Get Involved <Users size={20} />\n            </button>\n          </motion.div>\n        </div>\n      </div>\n    </section>\n  );\n};\n\nconst Donate = () => {\n  const tiers = [\n    { amount: \'5,000\', title: \'Community Friend\', desc: \'Funds essential school supplies for a student in need for a full term.\' },\n    { amount: \'20,000\', title: \'Impact Partner\', desc: \'Covers primary healthcare screening for an entire underserved family.\' },\n    { amount: \'50,000\', title: \'Champion of Service\', desc: \'Sponsors a vocational training course for a young local artisan.\' },\n  ];\n\n  return (\n    <section id=\"donate\" className=\"py-24 bg-brand-dark text-white text-center relative overflow-hidden\">\n      <div className=\"absolute top-0 left-0 w-full h-full hero-pattern opacity-10 pointer-events-none\"></div>\n      \n      <div className=\"max-w-7xl mx-auto px-6 relative z-10\">\n        <motion.div \n          initial={{ opacity: 0, y: 30 }}\n          whileInView={{ opacity: 1, y: 0 }}\n          viewport={{ once: true }}\n          className=\"mb-16\"\n        >\n          <h2 className=\"text-5xl md:text-6xl font-black mb-6\">Your Support <span className=\"text-rotaract-gold\">Drives Real Change</span></h2>\n          <p className=\"text-xl text-white/60 max-w-2xl mx-auto\">\n            Every contribution funds a project, equips a young leader, or serves a community in need in Ibadan.\n          </p>\n        </motion.div>\n\n        <div className=\"grid md:grid-cols-3 gap-8 mb-16\">\n          {tiers.map((tier, i) => (\n            <motion.div \n              key={i}\n              initial={{ opacity: 0, y: 30 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              transition={{ delay: i * 0.1 }}\n              viewport={{ once: true }}\n              className=\"bg-white/5 border border-white/10 p-10 rounded-3xl backdrop-blur-sm group hover:bg-white/10 transition-colors\"\n            >\n              <div className=\"text-4xl font-black text-rotaract-gold mb-2\">\342\202\246{tier.amount}</div>\n              <h4 className=\"text-xl font-bold mb-4 uppercase tracking-widest text-white/80\">{tier.title}</h4>\n              <p className=\"text-white/60 mb-8\">{tier.desc}</p>\n              <div className=\"w-12 h-1 bg-rotaract-gold mx-auto group-hover:w-24 transition-all\"></div>\n            </motion.div>\n          ))}\n        </div>\n\n        <button className=\"bg-rotaract-gold text-white px-16 py-6 rounded-full font-black text-2xl shadow-2xl hover:scale-105 transition-transform hover:shadow-rotaract-gold/20 mb-6\">\n          Donate Now\n        </button>\n        <p className=\"text-white/40 flex items-center justify-center gap-2\">\n          <CheckCircle2 size={16} /> Secure giving. Every naira is accounted for.\n        </p>\n      </div>\n    </section>\n  );\n};\n\nconst Footer = () => {\n  return (\n    <footer className=\"bg-white py-20 border-t border-gray-100\">\n      <div className=\"max-w-7xl mx-auto px-6\">\n        <div className=\"grid md:grid-cols-3 gap-16 mb-20\">\n          <div>\n            <h3 className=\"text-2xl font-black text-rotary-blue mb-4\">Rotaract Ring Road</h3>\n            <p className=\"text-brand-muted mb-8 max-w-xs leading-relaxed\">\n              Empowering young leaders to create sustainable change through hands-on service and fellowship in Ibadan.\n            </p>\n            <div className=\"flex gap-4\">\n              <a href=\"#\" className=\"w-10 h-10 rounded-full bg-brand-bg flex items-center justify-center text-rotary-blue hover:bg-rotary-blue hover:text-white transition-all\"><Instagram size={20} /></a>\n              <a href=\"#\" className=\"w-10 h-10 rounded-full bg-brand-bg flex items-center justify-center text-rotary-blue hover:bg-rotary-blue hover:text-white transition-all\"><Linkedin size={20} /></a>\n              <a href=\"#\" className=\"w-10 h-10 rounded-full bg-brand-bg flex items-center justify-center text-rotary-blue hover:bg-rotary-blue hover:text-white transition-all\"><Twitter size={20} /></a>\n              <a href=\"#\" className=\"w-10 h-10 rounded-full bg-brand-bg flex items-center justify-center text-rotary-blue hover:bg-rotary-blue hover:text-white transition-all\"><MessageSquare size={20} /></a>\n            </div>\n          </div>\n\n          <div>\n            <h4 className=\"text-lg font-bold text-brand-dark mb-8 uppercase tracking-widest\">Quick Links</h4>\n            <ul className=\"space-y-4 text-brand-muted font-medium\">\n              <li><a href=\"#home\" className=\"hover:text-rotary-blue transition-colors\">Home</a></li>\n              <li><a href=\"#about\" className=\"hover:text-rotary-blue transition-colors\">About Us</a></li>\n              <li><a href=\"#board\" className=\"hover:text-rotary-blue transition-colors\">Meet the Board</a></li>\n              <li><a href=\"#projects\" className=\"hover:text-rotary-blue transition-colors\">Past Projects</a></li>\n              <li><a href=\"#events\" className=\"hover:text-rotary-blue transition-colors\">Upcoming Events</a></li>\n              <li><a href=\"#partner\" className=\"hover:text-rotary-blue transition-colors\">Partner With Us</a></li>\n            </ul>\n          </div>\n\n          <div>\n            <h4 className=\"text-lg font-bold text-brand-dark mb-8 uppercase tracking-widest\">Contact Us</h4>\n            <ul className=\"space-y-6 text-brand-muted font-medium\">\n              <li className=\"flex gap-4\">\n                <MapPin className=\"text-rotaract-gold shrink-0\" size={24} />\n                <span>Ring Road, Ibadan, <br />Oyo State, Nigeria</span>\n              </li>\n              <li className=\"flex gap-4\">\n                <Mail className=\"text-rotaract-gold shrink-0\" size={24} />\n                <span>ringroadrotaract@gmail.com</span>\n              </li>\n              <li className=\"flex gap-4\">\n                <Phone className=\"text-rotaract-gold shrink-0\" size={24} />\n                <span>+234 810 000 0000</span>\n              </li>\n            </ul>\n          </div>\n        </div>\n\n        <div className=\"pt-10 border-t border-gray-100 flex flex-col md:row justify-between items-center gap-6\">\n          <p className=\"text-brand-muted text-sm font-medium\">\n            \302\251 2026 Rotaract Club of Ring Road Ibadan. District 9125 | Affiliated with Rotary International\n          </p>\n          <div className=\"flex gap-8 text-xs font-bold text-rotary-blue uppercase tracking-widest\">\n            <a href=\"#\">Privacy Policy</a>\n            <a href=\"#\">Terms of Use</a>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n\nexport default function App() {\n  const { scrollYProgress } = useScroll();\n  const scaleX = useSpring(scrollYProgress, {\n    stiffness: 100,\n    damping: 30,\n    restDelta: 0.001\n  });\n\n  return (\n    <div className=\"font-sans text-brand-dark bg-white\">\n      {/* Progress Bar */}\n      <motion.div \n        className=\"fixed top-0 left-0 right-0 h-1 bg-rotaract-gold z-[60] origin-left\"\n        style={{ scaleX }}\n      />\n      \n      <Navbar />\n      \n      <main>\n        <Hero />\n        <Impact />\n        <About />\n        <Board />\n        <Projects />\n        <Events />\n        <Partner />\n        <Donate />\n      </main>\n\n      <Footer />\n    </div>\n  );\n}"
        replacement_content: "const Navbar = () => {\n  const [isOpen, setIsOpen] = useState(false);\n  const [scrolled, setScrolled] = useState(false);\n\n  useEffect(() => {\n    const handleScroll = () => setScrolled(window.scrollY > 20);\n    window.addEventListener(\'scroll\', handleScroll);\n    return () => window.removeEventListener(\'scroll\', handleScroll);\n  }, []);\n\n  const navLinks = [\n    { name: \'Home\', href: \'#home\' },\n    { name: \'About\', href: \'#about\' },\n    { name: \'Board\', href: \'#board\' },\n    { name: \'Projects\', href: \'#projects\' },\n    { name: \'Events\', href: \'#events\' },\n    { name: \'Partner\', href: \'#partner\' },\n  ];\n\n  return (\n    <nav className={`fixed w-full z-50 transition-all duration-300 ${scrolled ? \'bg-white shadow-sm py-4 h-20 flex items-center border-b border-gray-100\' : \'bg-transparent py-6 h-24 flex items-center\'}`}>\n      <div className=\"max-w-7xl mx-auto px-10 w-full flex justify-between items-center\">\n        <a href=\"#home\" className={`text-2xl font-extrabold tracking-tight ${scrolled ? \'text-rotary-blue\' : \'text-white\'}`}>\n          Rotaract <span className=\"text-rotaract-gold\">Ring Road</span>\n        </a>\n\n        {/* Desktop Links */}\n        <div className=\"hidden md:flex items-center gap-8 font-medium text-sm\">\n          {navLinks.map((link) => (\n            <a \n              key={link.name} \n              href={link.href} \n              className={`transition-colors hover:text-rotaract-gold ${scrolled ? \'text-brand-muted hover:text-rotary-blue\' : \'text-white/80 hover:text-white\'}`}\n            >\n              {link.name}\n            </a>\n          ))}\n          <a href=\"#donate\" className=\"bg-rotaract-gold text-white px-6 py-2.5 rounded-full font-bold shadow-md hover:bg-[#e09818] transition-all transform hover:-translate-y-0.5\">\n            Donate\n          </a>\n        </div>\n\n        {/* Mobile Toggle */}\n        <button className=\"md:hidden\" onClick={() => setIsOpen(!isOpen)}>\n          {isOpen ? <X size={24} className={scrolled ? \'text-brand-dark\' : \'text-white\'} /> : <Menu size={24} className={scrolled ? \'text-brand-dark\' : \'text-white\'} />}\n        </button>\n      </div>\n\n      {/* Mobile Drawer */}\n      <AnimatePresence>\n        {isOpen && (\n          <motion.div \n            initial={{ opacity: 0, y: -20 }}\n            animate={{ opacity: 1, y: 0 }}\n            exit={{ opacity: 0, y: -20 }}\n            className=\"absolute top-full left-0 w-full bg-white shadow-2xl py-10 flex flex-col items-center gap-8 md:hidden border-t border-gray-50\"\n          >\n            {navLinks.map((link) => (\n              <a \n                key={link.name} \n                href={link.href} \n                onClick={() => setIsOpen(false)}\n                className=\"text-brand-dark font-bold text-lg\"\n              >\n                {link.name}\n              </a>\n            ))}\n            <a href=\"#donate\" onClick={() => setIsOpen(false)} className=\"bg-rotaract-gold text-white px-10 py-3 rounded-full font-bold text-lg shadow-lg\">\n              Donate\n            </a>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </nav>\n  );\n};\n\nconst Hero = () => {\n  return (\n    <section id=\"home\" className=\"relative min-h-[700px] md:h-[80vh] bg-rotary-blue flex items-center overflow-hidden\">\n      <div className=\"absolute inset-0 opacity-10\" style={{ backgroundImage: \'radial-gradient(#fff 1px, transparent 1px)\', backgroundSize: \'20px 20px\' }}></div>\n      \n      <div className=\"max-w-7xl mx-auto px-12 grid md:grid-cols-2 gap-10 items-center z-10 py-20\">\n        <motion.div \n          initial={{ opacity: 0, y: 20 }}\n          whileInView={{ opacity: 1, y: 0 }}\n          transition={{ duration: 0.8 }}\n          viewport={{ once: true }}\n          className=\"max-w-md\"\n        >\n          <span className=\"inline-block bg-rotaract-gold text-rotary-blue text-[10px] font-bold tracking-widest px-3 py-1 rounded mb-6 uppercase\">\n            Service Above Self \302\267 Ibadan, Nigeria\n          </span>\n          <h1 className=\"text-5xl md:text-6xl font-extrabold leading-[1.1] mb-6 tracking-tight text-white\">\n            Young Leaders. <br/>Real Service. <br/>Lasting Impact.\n          </h1>\n          <p className=\"text-blue-100 text-lg mb-8 leading-relaxed font-light\">\n            Rotaract Club of Ring Road Ibadan empowers young professionals to take action in their communities and lead meaningful change.\n          </p>\n          <div className=\"flex gap-4\">\n            <a href=\"#partner\" className=\"bg-white text-rotary-blue px-8 py-3 rounded-lg font-bold flex items-center shadow-lg hover:bg-gray-50 transition-all\">\n              Get Involved <span className=\"ml-2\">\342\206\222</span>\n            </a>\n            <a href=\"#projects\" className=\"border-2 border-white/30 text-white px-8 py-3 rounded-lg font-bold hover:bg-white/10 transition-all\">\n              Our Projects\n            </a>\n          </div>\n        </motion.div>\n\n        <motion.div \n          initial={{ opacity: 0, scale: 0.8 }}\n          whileInView={{ opacity: 1, scale: 1 }}\n          transition={{ duration: 1 }}\n          viewport={{ once: true }}\n          className=\"relative flex justify-center\"\n        >\n          <div className=\"relative w-64 h-64 md:w-80 md:h-80\">\n            <div className=\"absolute inset-0 bg-rotaract-gold rounded-full opacity-20 animate-pulse\"></div>\n            <svg viewBox=\"0 0 100 100\" className=\"w-full h-full text-white fill-current opacity-80 overflow-visible\">\n              <circle cx=\"50\" cy=\"50\" r=\"45\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"0.2\" className=\"opacity-30\" />\n              <path d=\"M50 10 L50 90 M10 50 L90 50 M20 20 L80 80 M80 20 L20 80\" stroke=\"currentColor\" strokeWidth=\"0.5\" className=\"opacity-50\" />\n              <motion.circle \n                cx=\"50\" cy=\"50\" r=\"30\" fill=\"none\" stroke=\"#F7A81B\" strokeWidth=\"1\" strokeDasharray=\"10 5\"\n                animate={{ rotate: 360 }}\n                transition={{ duration: 20, repeat: Infinity, ease: \"linear\" }}\n              />\n            </svg>\n            <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 flex items-center justify-center p-8 bg-white/5 backdrop-blur-xl rounded-full border border-white/10 shadow-2xl\">\n              <Users size={64} className=\"text-rotaract-gold opacity-90\" />\n            </div>\n          </div>\n        </motion.div>\n      </div>\n\n      <div className=\"absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce opacity-40\">\n        <ChevronRight size={32} className=\"rotate-90 text-white\" />\n      </div>\n    </section>\n  );\n};\n\nconst Impact = () => {\n  const stats = [\n    { value: 50, label: \'Members\', suffix: \'+\' },\n    { value: 12, label: \'Projects\', suffix: \'+\' },\n    { value: 1000, label: \'Lives Impacted\', suffix: \'+\' },\n    { value: 5, label: \'Years\', suffix: \'+\' },\n  ];\n\n  const Counter = ({ value, suffix }: { value: number, suffix: string }) => {\n    const [count, setCount] = useState(0);\n    const nodeRef = useRef(null);\n\n    useEffect(() => {\n      const observer = new IntersectionObserver((entries) => {\n        if (entries[0].isIntersecting) {\n          let start = 0;\n          const end = value;\n          const duration = 1500;\n          const increment = end / (duration / 16);\n          \n          const timer = setInterval(() => {\n            start += increment;\n            if (start >= end) {\n              setCount(end);\n              clearInterval(timer);\n            } else {\n              setCount(Math.floor(start));\n            }\n          }, 16);\n        }\n      }, { threshold: 0.5 });\n\n      if (nodeRef.current) observer.observe(nodeRef.current);\n      return () => observer.disconnect();\n    }, [value]);\n\n    return <span ref={nodeRef}>{count}{suffix}</span>;\n  };\n\n  return (\n    <section id=\"impact\" className=\"bg-rotaract-gold h-auto py-10 md:h-24 md:py-0 flex items-center justify-around px-12 border-b border-white/10\">\n      <div className=\"max-w-7xl mx-auto w-full flex flex-wrap md:flex-nowrap items-center justify-around gap-8\">\n        {stats.map((stat, i) => (\n          <div key={i} className=\"flex items-center gap-8 md:gap-12 lg:gap-16\">\n            <div className=\"text-center\">\n              <div className=\"text-3xl font-black text-rotary-blue tracking-tighter\">\n                <Counter value={stat.value} suffix={stat.suffix} />\n              </div>\n              <div className=\"text-[10px] uppercase font-bold text-rotary-blue/70 tracking-widest mt-0.5\">{stat.label}</div>\n            </div>\n            {i < stats.length - 1 && (\n              <div className=\"hidden md:block h-8 w-px bg-rotary-blue/20\"></div>\n            )}\n          </div>\n        ))}\n      </div>\n    </section>\n  );\n};\n\nconst About = () => {\n  return (\n    <section id=\"about\" className=\"py-24 bg-white overflow-hidden\">\n      <div className=\"max-w-7xl mx-auto px-12\">\n        <div className=\"grid md:grid-cols-2 gap-16 items-center\">\n          <motion.div \n            initial={{ opacity: 0, x: -20 }}\n            whileInView={{ opacity: 1, x: 0 }}\n            transition={{ duration: 0.6 }}\n            viewport={{ once: true }}\n          >\n            <h2 className=\"text-xs font-bold uppercase tracking-widest text-rotaract-gold mb-4\">The Foundation</h2>\n            <h3 className=\"text-4xl font-extrabold text-brand-dark mb-8 leading-[1.2] tracking-tight\">\n              Rooted in Service, <br />\n              <span className=\"text-rotary-blue\">Driven by Action.</span>\n            </h3>\n            <div className=\"space-y-6 text-brand-muted leading-relaxed text-sm lg:text-base\">\n              <p>\n                The Rotaract Club of Ring Road Ibadan is part of a global effort to bring peace and international understanding to the world. We provide an opportunity for young people to enhance their knowledge and skills for personal development.\n              </p>\n              <p>\n                Our mission is simple: to address the physical and social needs of our community while promoting better relations between all people worldwide through a framework of friendship and service.\n              </p>\n            </div>\n          </motion.div>\n\n          <div className=\"grid grid-cols-1 gap-6\">\n            <div className=\"flex flex-col justify-center items-center text-center p-12 bg-brand-bg rounded-3xl border border-gray-50 shadow-sm\">\n               <div className=\"italic font-serif text-3xl md:text-4xl text-rotary-blue mb-4\">\"Service Above Self\"</div>\n               <div className=\"text-rotaract-gold font-bold text-sm uppercase tracking-widest\">The Rotary Motto</div>\n            </div>\n            <div className=\"bg-white p-8 rounded-2xl border-l-4 border-rotaract-gold shadow-sm flex items-start gap-6\">\n              <div className=\"w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center shrink-0\">\n                <Heart size={20} className=\"text-rotary-blue\" />\n              </div>\n              <div>\n                <div className=\"font-bold text-rotary-blue text-lg\">Community Impact</div>\n                <p className=\"text-xs lg:text-sm text-brand-muted mt-2 font-medium\">Focusing on high-impact projects that solve real problems in Ibadan settlements.</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n\nconst Board = () => {\n  const members = [\n    { initials: \'OA\', name: \'Rtr. Olabisi Adeniyi\', role: \'President\', isLead: true },\n    { initials: \'KP\', name: \'Rtr. King Praise\', role: \'VP & Secretary\', isLead: false },\n    { initials: \'AH\', name: \'Rtr. Abiola Hassan\', role: \'Welfare Director\', isLead: false },\n    { initials: \'SJ\', name: \'Rtr. Sarah Johnson\', role: \'Public Relations\', isLead: false },\n  ];\n\n  return (\n    <section id=\"board\" className=\"py-24 bg-white border-t border-gray-100\">\n      <div className=\"max-w-7xl mx-auto px-12\">\n        <div className=\"flex justify-between items-end mb-12\">\n          <div>\n            <h2 className=\"text-xs font-bold uppercase tracking-widest text-rotaract-gold mb-3\">The Board</h2>\n            <h3 className=\"text-3xl font-extrabold text-rotary-blue tracking-tight\">Our Leadership <span className=\"text-gray-400 font-medium ml-2 text-sm italic\">2025\342\200\2232026</span></h3>\n          </div>\n        </div>\n\n        <div className=\"grid md:grid-cols-2 lg:grid-cols-4 gap-6\">\n          {members.map((m, i) => (\n            <motion.div \n              key={i}\n              initial={{ opacity: 0, y: 10 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              transition={{ delay: i * 0.1 }}\n              viewport={{ once: true }}\n              className={`flex items-center gap-4 p-5 rounded-2xl bg-white border-2 transition-all group cursor-default ${m.isLead ? \'border-rotaract-gold shadow-md\' : \'border-gray-100 hover:border-rotary-blue/20 shadow-sm\'}`}\n            >\n              <div className={`w-12 h-12 rounded-full flex items-center justify-center font-bold text-sm shrink-0 transition-transform group-hover:scale-110 ${m.isLead ? \'bg-rotary-blue text-white\' : \'bg-gray-100 text-rotary-blue\'}`}>\n                {m.initials}\n              </div>\n              <div className=\"overflow-hidden\">\n                <div className=\"text-sm font-bold text-brand-dark truncate\">{m.name}</div>\n                <div className={`text-[10px] font-bold uppercase tracking-wide ${m.isLead ? \'text-rotaract-gold\' : \'text-brand-muted\'}`}>{m.role}</div>\n              </div>\n            </motion.div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n};\n\nconst Projects = () => {\n  const projects = [\n    { title: \'Health & Wellness\', icon: Stethoscope, color: \'border-rotaract-gold\' },\n    { title: \'Education Outreach\', icon: BookOpen, color: \'border-rotary-blue\' },\n    { title: \'Environmental Action\', icon: Leaf, color: \'border-rotaract-gold\' },\n    { title: \'Youth Empowerment\', icon: Zap, color: \'border-rotary-blue\' },\n  ];\n\n  return (\n    <section id=\"projects\" className=\"py-24 bg-brand-bg\">\n      <div className=\"max-w-7xl mx-auto px-12\">\n        <h2 className=\"text-xs font-bold uppercase tracking-widest text-rotaract-gold mb-10\">Impact in Action</h2>\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n          {projects.map((p, i) => (\n            <motion.div \n              key={i}\n              initial={{ opacity: 0, scale: 0.95 }}\n              whileInView={{ opacity: 1, scale: 1 }}\n              transition={{ delay: i * 0.05 }}\n              viewport={{ once: true }}\n              className={`bg-white p-6 rounded-xl border-l-4 ${p.color} shadow-sm group hover:shadow-md transition-shadow`}\n            >\n              <p.icon className=\"text-rotary-blue mb-4 opacity-70 group-hover:opacity-100 transition-opacity\" size={24} />\n              <div className=\"font-bold text-rotary-blue text-base group-hover:text-rotaract-gold transition-colors\">{p.title}</div>\n              <p className=\"text-xs text-brand-muted mt-2 leading-relaxed font-medium\">Delivering critical support to schools and health centers across Ibadan.</p>\n            </motion.div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n};\n\nconst Events = () => {\n  const events = [\n    { month: \'MAY\', day: \'10\', title: \'Club Meeting\', lead: \'Rtr. King Praise\' },\n    { month: \'MAY\', day: \'24\', title: \'Joint Fellowship\', lead: \'Rtr. Risqat\' },\n    { month: \'JUN\', day: \'13\', title: \'Rotary Meeting\', lead: \'Rtr. Toffy\' },\n  ];\n\n  return (\n    <section id=\"events\" className=\"py-24 bg-white\">\n      <div className=\"max-w-7xl mx-auto px-12\">\n        <div className=\"flex items-center gap-10\">\n          <div className=\"w-1/3\">\n            <h2 className=\"text-xs font-bold uppercase tracking-widest text-rotaract-gold mb-4\">The Calendar</h2>\n            <h3 className=\"text-3xl font-extrabold text-rotary-blue mb-6 tracking-tight\">Upcoming Events</h3>\n            <p className=\"text-sm text-brand-muted leading-relaxed font-medium\">Join us at our weekly gatherings and monthly service outings in the Ring Road area.</p>\n          </div>\n          <div className=\"w-2/3 grid grid-cols-1 md:grid-cols-2 gap-4\">\n            {events.map((e, i) => (\n              <motion.div \n                key={i}\n                initial={{ opacity: 0, x: 20 }}\n                whileInView={{ opacity: 1, x: 0 }}\n                transition={{ delay: i * 0.1 }}\n                viewport={{ once: true }}\n                className=\"flex items-center gap-6 p-4 rounded-2xl bg-white border border-gray-100 hover:shadow-md transition-all group\"\n              >\n                <div className=\"flex-shrink-0 w-14 h-14 bg-blue-50 rounded-xl flex flex-col items-center justify-center text-rotary-blue group-hover:bg-rotary-blue group-hover:text-white transition-colors\">\n                  <span className=\"text-[10px] uppercase font-bold tracking-tighter\">{e.month}</span>\n                  <span className=\"text-xl font-black leading-none\">{e.day}</span>\n                </div>\n                <div>\n                  <div className=\"text-sm font-bold text-brand-dark group-hover:text-rotary-blue transition-colors\">{e.title}</div>\n                  <div className=\"text-[10px] text-brand-muted font-bold uppercase tracking-wide mt-0.5\">Lead: {e.lead}</div>\n                </div>\n              </motion.div>\n            ))}\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n\nconst Donate = () => {\n  return (\n    <section id=\"donate\" className=\"py-16 bg-white border-t border-gray-50\">\n      <div className=\"max-w-7xl mx-auto px-12\">\n        <div className=\"bg-brand-dark rounded-3xl p-12 text-white text-center shadow-2xl relative overflow-hidden flex flex-col md:row items-center justify-between gap-10\">\n          <div className=\"absolute top-0 right-0 w-32 h-32 bg-rotaract-gold -mr-16 -mt-16 rounded-full opacity-20 blur-xl\"></div>\n          <div className=\"absolute bottom-0 left-0 w-32 h-32 bg-rotary-blue -ml-16 -mb-16 rounded-full opacity-20 blur-xl\"></div>\n          \n          <div className=\"text-left md:w-1/2\">\n            <h2 className=\"text-xs font-bold uppercase tracking-widest text-rotaract-gold mb-3\">Support the Mission</h2>\n            <h3 className=\"text-3xl font-extrabold mb-4 tracking-tight\">Fuel Our Projects</h3>\n            <p className=\"text-sm text-gray-400 leading-relaxed font-light\">Every naira contributed directly supports community healthcare, literacy programs, and vocational training across Ibadan settlements.</p>\n          </div>\n          \n          <div className=\"flex flex-col sm:flex-row gap-4 w-full md:w-auto\">\n            <button className=\"bg-rotaract-gold text-white px-10 py-3.5 rounded-lg font-bold text-sm shadow-lg hover:bg-[#e09818] transition-all transform hover:scale-105\">\n              Donate Now\n            </button>\n            <button className=\"bg-white/5 text-white px-10 py-3.5 rounded-lg font-bold text-sm border border-white/10 hover:bg-white/10 transition-all transition-all\">\n              Become a Partner\n            </button>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n\nconst Footer = () => {\n  return (\n    <footer className=\"bg-white py-12 border-t border-gray-100 flex items-center\">\n      <div className=\"max-w-7xl mx-auto px-12 w-full flex flex-col md:row justify-between items-center gap-8 text-[11px] text-gray-400 font-bold uppercase tracking-widest\">\n        <div>\302\251 2026 Rotaract Club of Ring Road Ibadan. District 9125</div>\n        <div className=\"flex gap-8 group\">\n          <a href=\"#\" className=\"hover:text-rotary-blue transition-colors\">LinkedIn</a>\n          <a href=\"#\" className=\"hover:text-rotary-blue transition-colors\">Instagram</a>\n          <a href=\"#\" className=\"hover:text-rotary-blue transition-colors\">WhatsApp</a>\n        </div>\n        <div className=\"text-rotary-blue flex items-center gap-2\">\n          <span className=\"w-1.5 h-1.5 bg-rotaract-gold rounded-full\"></span>\n          Affiliated with Rotary International\n        </div>\n      </div>\n    </footer>\n  );\n};\n\nexport default function App() {\n  const { scrollYProgress } = useScroll();\n  const scaleX = useSpring(scrollYProgress, {\n    stiffness: 100,\n    damping: 30,\n    restDelta: 0.001\n  });\n\n  return (\n    <div className=\"font-sans text-brand-dark bg-white subpixel-antialiased\">\n      <motion.div \n        className=\"fixed top-0 left-0 right-0 h-0.5 bg-rotaract-gold z-[100] origin-left\"\n        style={{ scaleX }}\n      />\n      \n      <Navbar />\n      \n      <main>\n        <Hero />\n        <Impact />\n        <About />\n        <Board />\n        <Projects />\n        <Events />\n        <Donate />\n      </main>\n\n      <Footer />\n    </div>\n  );\n}\n"
      }
      num_matches: 1
    }
  }
}
