slateZ(-50px)\\\" }}>\\n              <div className=\\\"w-full h-full border-[1px] border-white rounded-full\\\"></div>\\n            </div>\\n            <div className=\\\"absolute inset-0 opacity-10\\\" style={{ transform: \\\"rotateY(75deg) translateZ(50px)\\\" }}>\\n              <div className=\\\"w-full h-full border-[1px] border-white rounded-full\\\"></div>\\n            </div>\\n\\n            {/* Floating Service Particles */}\\n            {[...Array(5)].map((_, i) => (\\n              <motion.div\\n                key={i}\\n                className=\\\"absolute w-1.5 h-1.5 bg-white rounded-full\\\"\\n                animate={{\\n                  y: [0, -40, 0],\\n                  opacity: [0.2, 0.8, 0.2],\\n                  scale: [1, 1.5, 1],\\n                }}\\n                transition={{\\n                  duration: 4 + i,\\n                  repeat: Infinity,\\n                  ease: \\\"easeInOut\\\",\\n                  delay: i * 0.5\\n                }}\\n                style={{\\n                  top: `${20 + i * 15}%`,\\n                  left: `${10 + i * 20}%`,\\n                  boxShadow: \\\"0 0 15px white\\\",\\n                  transform: `translateZ(${30 + i * 20}px)`\\n                }}\\n              />\\n            ))}\\n          </motion.div>\\n          \\n          {/* Static Center Badge Overlay (Optional: Fixed in 2D space relative to parent) */}\\n          <div className=\\\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 flex items-center justify-center w-24 h-24 md:w-32 md:h-32 bg-white/5 backdrop-blur-md rounded-full border border-white/10 shadow-2xl z-20 pointer-events-none\\\">\\n            <div className=\\\"text-rotaract-gold font-black text-[10px] md:text-xs tracking-[0.3em] uppercase\\\">Service</div>\\n          </div>\\n        </motion.div>\\n\", \"TargetContent\":\"        <motion.div \\n          initial={{ opacity: 0, scale: 0.8 }}\\n          whileInView={{ opacity: 1, scale: 1 }}\\n          transition={{ duration: 1 }}\\n          viewport={{ once: true }}\\n          className=\\\"relative flex justify-center\\\"\\n        >\\n          <div className=\\\"relative w-64 h-64 md:w-80 md:h-80\\\">\\n            <div className=\\\"absolute inset-0 bg-rotaract-gold rounded-full opacity-20 animate-pulse\\\"></div>\\n            <svg viewBox=\\\"0 0 100 100\\\" className=\\\"w-full h-full text-white fill-current opacity-80 overflow-visible\\\">\\n              <circle cx=\\\"50\\\" cy=\\\"50\\\" r=\\\"45\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"0.2\\\" className=\\\"opacity-30\\\" />\\n              <path d=\\\"M50 10 L50 90 M10 50 L90 50 M20 20 L80 80 M80 20 L20 80\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"0.5\\\" className=\\\"opacity-50\\\" />\\n              <motion.circle \\n                cx=\\\"50\\\" cy=\\\"50\\\" r=\\\"30\\\" fill=\\\"none\\\" stroke=\\\"#F7A81B\\\" strokeWidth=\\\"1\\\" strokeDasharray=\\\"10 5\\\"\\n                animate={{ rotate: 360 }}\\n                transition={{ duration: 20, repeat: Infinity, ease: \\\"linear\\\" }}\\n              />\\n            </svg>\\n            <div className=\\\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 flex items-center justify-center p-8 bg-white/5 backdrop-blur-xl rounded-full border border-white/10 shadow-2xl\\\">\\n              <Users size={64} className=\\\"text-rotaract-gold opacity-90\\\" />\\n            </div>\\n          </div>\\n        </motion.div>\\n\", \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Replacing Hero SVG with a 3D rotating gold wheel.\", \"toolSummary\":\"Replace Hero SVG with 3D Wheel\"}"
