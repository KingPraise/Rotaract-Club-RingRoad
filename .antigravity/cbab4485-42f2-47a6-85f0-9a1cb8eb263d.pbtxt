      arguments_json: "{\"Instruction\":\"Update all Rotary logo instances to the new official image URL and adjust filters for better visibility.\", \"ReplacementChunks\":[{\"ReplacementContent\":\"// --- Constants ---\\n\\nconst ROTARY_LOGO_URL = \\\"https://rotary-ribi.org/upimages/PageMainPics/4_Wheel2013_Transp_1200.png\\\";\\n\\nconst Modal = ({ isOpen, onClose, event }: { isOpen: boolean, onClose: () => void, event: Event | null }) => {\\n\", \"TargetContent\":\"// --- Constants ---\\n\\nconst ROTARY_LOGO_BASE64 = \\\"data:image/svg+xml;base64,\\\";\\n\\nconst Modal = ({ isOpen, onClose, event }: { isOpen: boolean, onClose: () => void, event: Event | null }) => {\\n\"}, {\"ReplacementContent\":\"          <img \\n            src={ROTARY_LOGO_URL}\\n            alt=\\\"Rotary International\\\"\\n            className=\\\"h-10 md:h-12 mb-8 opacity-90 object-contain ml-0\\\"\\n            style={{ filter: \'brightness(0) invert(1)\' }}\\n            referrerPolicy=\\\"no-referrer\\\"\\n          />\\n\", \"TargetContent\":\"          <img \\n            src={ROTARY_LOGO_BASE64}\\n            alt=\\\"Rotary International\\\"\\n            className=\\\"h-10 md:h-12 mb-8 opacity-90 object-contain ml-0\\\"\\n            style={{ filter: \'brightness(0) invert(1)\' }}\\n          />\\n\"}, {\"ReplacementContent\":\"            {/* The 3D Wheel (Layered for Depth) */}\\n            <div className=\\\"absolute inset-0 flex items-center justify-center\\\" style={{ transform: \\\"translateZ(20px)\\\" }}>\\n              <img \\n                src={ROTARY_LOGO_URL}\\n                alt=\\\"3D Rotary Wheel\\\"\\n                className=\\\"w-full h-full object-contain filter drop-shadow-[0_0_50px_rgba(247,168,27,0.6)]\\\"\\n                style={{ \\n                  filter: \'contrast(1.1) brightness(1.1)\',\\n                }}\\n                referrerPolicy=\\\"no-referrer\\\"\\n              />\\n            </div>\\n\", \"TargetContent\":\"            {/* The 3D Wheel (Layered for Depth) */}\\n            <div className=\\\"absolute inset-0 flex items-center justify-center\\\" style={{ transform: \\\"translateZ(20px)\\\" }}>\\n              <img \\n                src={ROTARY_LOGO_BASE64}\\n                alt=\\\"3D Rotary Wheel\\\"\\n                className=\\\"w-full h-full object-contain filter drop-shadow-[0_0_50px_rgba(247,168,27,0.6)]\\\"\\n                style={{ \\n                  filter: \'brightness(0) saturate(100%) invert(84%) sepia(57%) saturate(2853%) hue-rotate(345deg) brightness(101%) contrast(94%)\',\\n                }}\\n              />\\n            </div>\\n\"}, {\"ReplacementContent\":\"              <div className=\\\"pt-6 flex items-center gap-8 opacity-80 filter grayscale hover:grayscale-0 transition-all duration-500\\\">\\n                <img \\n                  src={ROTARY_LOGO_URL} \\n                  alt=\\\"Rotary International Logo\\\" \\n                  className=\\\"h-10 md:h-12 object-contain\\\"\\n                  referrerPolicy=\\\"no-referrer\\\"\\n                />\\n                <div className=\\\"h-10 w-px bg-gray-200\\\"></div>\\n\", \"TargetContent\":\"              <div className=\\\"pt-6 flex items-center gap-8 opacity-80 filter grayscale hover:grayscale-0 transition-all duration-500\\\">\\n                <img \\n                  src={ROTARY_LOGO_BASE64} \\n                  alt=\\\"Rotary International Logo\\\" \\n                  className=\\\"h-10 md:h-12 object-contain\\\"\\n                  style={{ filter: \'brightness(0) saturate(100%) invert(21%) sepia(85%) saturate(1863%) hue-rotate(204deg) brightness(91%) contrast(106%)\' }} /* Custom filter for blue */\\n                />\\n                <div className=\\\"h-10 w-px bg-gray-200\\\"></div>\\n\"}], \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Updating all rotary images with the new URL.\", \"toolSummary\":\"Update Rotary logo URL everywhere\"}"
